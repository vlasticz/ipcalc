{
  "name": "ipcalc-tailwind",
  "private": true,
  "description": "Build-time only: Tailwind CSS CLI. Runtime is pure Go, no Node.",
  "scripts": {
    "build": "tailwindcss -i input.css -o static/app.css --minify",
    "watch": "tailwindcss -i input.css -o static/app.css --watch"
  },
