{{define "partial_result"}}
<section id="result" class="space-y-3">
  {{if .Warning}}
  <div class="border border-[var(--color-warn)] text-[var(--color-warn)] bg-[var(--color-panel)] rounded p-3 text-sm mono">
    {{.Warning}}
  </div>
  {{end}}

  {{if .Result}}
  {{/* PRIMARY — Range: network, hosts, broadcast. The headline section. */}}
  <div class="section section-primary space-y-3">
    <div class="flex items-center justify-between gap-2">
      <span class="section-title" style="margin: 0">Range</span>
      <a href="/split?ip={{.Result.Network}}&amp;mask={{.Result.PrefixLen}}" class="action-link"
         title="Open this network as the parent in /split">Split this →</a>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <span class="hero-addr">{{.Result.Network}}/{{.Result.PrefixLen}}</span>
      {{if .Result.IsRFC1918}}<span class="chip chip-accent">RFC1918</span>{{end}}
      {{if .Result.IsLoopback}}<span class="chip chip-warn">loopback</span>{{end}}
      {{if .Result.IsLinkLocal}}<span class="chip chip-warn">link-local</span>{{end}}
      {{if .Result.IsMulticast}}<span class="chip chip-warn">multicast</span>{{end}}
      {{if .Result.IsPublic}}<span class="chip chip-err" title="Publicly routable address — not for LAN assignment">public</span>{{end}}
    </div>

    <dl class="kv">
      <dt>Hosts</dt>
      <dd class="range">
        <span>{{.Result.HostMin}}</span>
        <span class="range-arrow">→</span>
        <span>{{.Result.HostMax}}</span>
        <span class="range-count"><span data-num="{{.Result.HostCount}}">{{.Result.HostCount}}</span> usable</span>
      </dd>
      {{if .Result.Broadcast.IsValid}}
      <dt>Broadcast</dt>
      <dd>{{.Result.Broadcast}}</dd>
      {{end}}
    </dl>
  </div>

  {{/* SECONDARY — Mask: netmask, wildcard. */}}
  <div class="section">
    <div class="section-title">Mask</div>
    <dl class="kv">
      <dt>Netmask</dt>
      <dd>{{.Result.Netmask}} <span class="text-[var(--color-fg-dim)]">/{{.Result.PrefixLen}}</span></dd>
      <dt>Wildcard</dt>
      <dd>{{.Result.Wildcard}}</dd>
    </dl>
  </div>

  {{/* REFERENCE — Class, arpa, binary with network/host bit colouring. */}}
  <div class="section">
    <div class="section-title">Reference</div>
    <dl class="kv">
      {{if .Result.Class}}
      <dt>Class</dt>
      <dd>{{.Result.Class}}</dd>
      {{end}}
      <dt>Arpa</dt>
      <dd>{{.Result.ReverseDNS}}</dd>
      <dt>Binary</dt>
      <dd><span class="bin-net">{{.Result.BinaryAddrNet}}</span><span class="bin-host">{{.Result.BinaryAddrHost}}</span></dd>
      <dt>Mask bin</dt>
      <dd><span class="bin-net">{{.Result.BinaryMaskNet}}</span><span class="bin-host">{{.Result.BinaryMaskHost}}</span></dd>
    </dl>
  </div>
  {{end}}

  {{if and (not .Result) (not .Warning)}}
  <div class="text-[var(--color-fg-dim)] text-sm">
    Enter an IPv4 address and a mask (CIDR or dotted) to see network details.
  </div>
  {{end}}
</section>
{{end}}
