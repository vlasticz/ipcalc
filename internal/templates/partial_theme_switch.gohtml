{{define "partial_theme_switch"}}
<div class="theme-picker" data-theme-picker>
  <button type="button" class="theme-trigger"
          aria-haspopup="true" aria-expanded="false"
          title="Change accent colour">
    <span class="theme-dot theme-dot-current"></span>
    <span class="theme-chevron">▾</span>
  </button>
  <div class="theme-menu" role="menu" hidden>
    {{range $a := .Accents}}
    <button type="button" role="menuitem" data-accent="{{$a}}"
            data-selected="{{if eq $.Accent $a}}true{{else}}false{{end}}">
      <span class="theme-dot theme-dot-{{$a}}"></span>
      <span>{{$a}}</span>
    </button>
    {{end}}
  </div>
</div>
{{end}}
