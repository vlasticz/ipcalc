{{define "partial_theme_switch"}}
{{/* No HTMX: JS intercepts the form (see layout.gohtml's inline script) and
     updates the cookie + body class without a roundtrip. If JS is off, the
     form submits normally and the server's /theme handler does a 303
     redirect back, giving a graceful fallback. */}}
<form action="/theme" method="post" class="flex gap-1 items-center" data-theme-switch>
  {{range $a := .Accents}}
  <button type="submit" name="accent" value="{{$a}}" data-accent="{{$a}}"
          data-selected="{{if eq $.Accent $a}}true{{else}}false{{end}}"
          title="Switch accent to {{$a}}">{{$a}}</button>
  {{end}}
</form>
{{end}}
