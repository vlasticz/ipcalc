{{define "layout"}}<!doctype html>
<html lang="en" class="bg-[var(--color-bg)]">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}ipcalc{{end}}</title>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body class="accent-{{.Accent}} min-h-screen text-[var(--color-fg)]">
  <header class="border-b border-[var(--color-border)] px-6 py-3 grid grid-cols-3 items-center">
    <a href="/" class="mono font-semibold text-lg justify-self-start">
      <span style="color: var(--accent)">ip</span>calc
    </a>
    <nav class="nav-pills justify-self-center" aria-label="Primary">
      <a href="/" class="nav-pill" data-active="{{if eq .ActivePage "calc"}}true{{else}}false{{end}}">calculator</a>
      <a href="/split" class="nav-pill" data-active="{{if eq .ActivePage "split"}}true{{else}}false{{end}}">subnetting</a>
      <a href="/saved" class="nav-pill" data-active="{{if eq .ActivePage "saved"}}true{{else}}false{{end}}">saved</a>
    </nav>
    <div class="justify-self-end">
      {{template "partial_theme_switch" .}}
    </div>
  </header>
  <main class="px-6 py-8 max-w-5xl mx-auto">
    {{block "content" .}}{{end}}
  </main>

  <script>
    // Locale-aware number formatting. Any element with [data-num="<int>"]
    // gets its textContent replaced with the formatted version using the
    // browser's locale (navigator.language). Re-run after HTMX swaps so
    // fragments coming from the server are formatted too.
    (function () {
      const fmt = new Intl.NumberFormat();
      function formatNumbers(root) {
        (root || document).querySelectorAll('[data-num]').forEach(el => {
          const n = Number(el.dataset.num);
          if (!Number.isNaN(n)) el.textContent = fmt.format(n);
        });
      }
      document.addEventListener('DOMContentLoaded', () => formatNumbers());
      document.body.addEventListener('htmx:afterSwap', e => formatNumbers(e.target));
    })();

    // Theme picker — dropdown with colour swatches. Writes the accent
    // cookie (with both max-age and explicit expires so every browser
    // persists it), swaps body.className so CSS variables re-tint
    // every accent-coloured element instantly. No HTTP roundtrip.
    (function () {
      const picker = document.querySelector('[data-theme-picker]');
      if (!picker) return;
      const trigger = picker.querySelector('.theme-trigger');
      const menu = picker.querySelector('.theme-menu');
      const items = picker.querySelectorAll('.theme-menu button');

      function setOpen(open) {
        menu.hidden = !open;
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      function setAccent(accent) {
        const expires = new Date(Date.now() + 365 * 86400 * 1000).toUTCString();
        document.cookie =
          'ipcalc_accent=' + accent +
          '; path=/; max-age=31536000; expires=' + expires + '; SameSite=Lax';
        document.body.className = document.body.className
          .replace(/accent-\w+/g, 'accent-' + accent);
        items.forEach(b => {
          b.dataset.selected = (b.dataset.accent === accent) ? 'true' : 'false';
        });
      }

      trigger.addEventListener('click', e => {
        e.stopPropagation();
        setOpen(menu.hidden);
      });
      items.forEach(item => {
        item.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          setAccent(item.dataset.accent);
          setOpen(false);
        });
      });
      document.addEventListener('click', e => {
        if (!picker.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>
</body>
</html>
{{end}}
